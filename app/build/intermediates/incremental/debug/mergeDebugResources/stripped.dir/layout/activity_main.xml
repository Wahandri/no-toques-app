<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- === PANTALLA PRINCIPAL === -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Título con icono de ajustes -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_manage"
                    android:contentDescription="Ajustes" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Alarma de proximidad ultrasónica"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/inactive_gray" />

            <!-- Botón ACTIVAR / DETENER -->
            <Button
                android:id="@+id/btnToggle"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="220dp"
                android:layout_height="80dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/inactive_gray"
                android:onClick="onToggleClick"
                android:text="@string/btn_activar"
                android:textColor="@color/on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Estado del servicio -->
            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/inactive_gray" />

            <!-- INDICADOR DE DISTANCIA -->
            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_distancia"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/distanceBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_bar_gradient" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/inactive_gray" />

            <!-- SENSIBILIDAD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Umbral de distancia"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 cm"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sensitivitySeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:max="40"
                    android:progress="20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50 cm"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSensitivityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/label_sensibilidad"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/inactive_gray" />

            <!-- FRECUENCIA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/label_frecuencia"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/frequencyGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb18kHz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="@string/opcion_18kHz" />

                <RadioButton
                    android:id="@+id/rb20kHz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:checked="true"
                    android:text="@string/opcion_20kHz" />

                <RadioButton
                    android:id="@+id/rb22kHz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/opcion_22kHz" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/inactive_gray" />

            <!-- MODOS DE ALARMA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Modos de alarma"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/chkPitido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/check_pitido" />

            <CheckBox
                android:id="@+id/chkVibracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/check_vibracion" />

            <CheckBox
                android:id="@+id/chkNotificacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/check_notificacion" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/inactive_gray" />

        </LinearLayout>
    </ScrollView>

    <!-- === OVERLAY DE ALARMA CON TECLADO NUMÉRICO === -->
    <LinearLayout
        android:id="@+id/alarmOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/alarm_red"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_alarma_activa"
            android:textColor="@color/on_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlarmDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text=""
            android:textColor="@color/on_primary"
            android:textSize="18sp" />

        <!-- Display de contraseña: 4 dígitos -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/pwDot1"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:textSize="32sp"
                android:textColor="@color/on_primary"
                android:text="○" />

            <TextView
                android:id="@+id/pwDot2"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:textSize="32sp"
                android:textColor="@color/on_primary"
                android:text="○" />

            <TextView
                android:id="@+id/pwDot3"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:textSize="32sp"
                android:textColor="@color/on_primary"
                android:text="○" />

            <TextView
                android:id="@+id/pwDot4"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:textSize="32sp"
                android:textColor="@color/on_primary"
                android:text="○" />
        </LinearLayout>

        <!-- Mensaje de error -->
        <TextView
            android:id="@+id/tvPwError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text=""
            android:textColor="#FFCDD2"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Teclado numérico -->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="true">

            <Button
                android:id="@+id/kb1"
                style="@style/KeypadButton"
                android:text="1" />
            <Button
                android:id="@+id/kb2"
                style="@style/KeypadButton"
                android:text="2" />
            <Button
                android:id="@+id/kb3"
                style="@style/KeypadButton"
                android:text="3" />
            <Button
                android:id="@+id/kb4"
                style="@style/KeypadButton"
                android:text="4" />
            <Button
                android:id="@+id/kb5"
                style="@style/KeypadButton"
                android:text="5" />
            <Button
                android:id="@+id/kb6"
                style="@style/KeypadButton"
                android:text="6" />
            <Button
                android:id="@+id/kb7"
                style="@style/KeypadButton"
                android:text="7" />
            <Button
                android:id="@+id/kb8"
                style="@style/KeypadButton"
                android:text="8" />
            <Button
                android:id="@+id/kb9"
                style="@style/KeypadButton"
                android:text="9" />
            <Button
                android:id="@+id/kbDelete"
                style="@style/KeypadButton"
                android:text="⌫" />
            <Button
                android:id="@+id/kb0"
                style="@style/KeypadButton"
                android:text="0" />
            <Button
                android:id="@+id/kbClear"
                style="@style/KeypadButton"
                android:text="✕" />

        </GridLayout>

        <!-- Botón de emergencia: detiene TODO el servicio -->
        <Button
            android:id="@+id/btnEmergencyStop"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#B71C1C"
            android:text="DETENER VIGILANTE"
            android:textColor="@color/on_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
